{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(pnpm -r publish *)",
      "Bash(pnpm changeset publish *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git switch -f *)",
      "Bash(git switch --force *)",
      "Bash(git switch --discard-changes *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh release *)",
      "Bash(gh api *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh label list *)",

      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm build *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * build *)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm --filter * lint *)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * typecheck *)",
      "Bash(pnpm changeset)",
      "Bash(pnpm changeset status *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)"
    ]
  }
}
