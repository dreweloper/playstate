{
  "name": "@playstate/react",
  "version": "0.0.0",
  "description": "React hook and components to show what you are playing on Spotify",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreweloper/playstate.git",
    "directory": "packages/react"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack ."
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "tsdown": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "es2022",
    "platform": "neutral",
    "fixedExtension": false
  }
}
